# Backend configuration.
# Copy to .env or set as environment variables. All values have sensible
# defaults, so this file is optional for local dev.

# --- Matching -------------------------------------------------------------
# Cosine-similarity threshold for a positive match. Tune with
# `python scripts/threshold_tuning.py`.
# FR_MATCH_THRESHOLD=0.45

# --- Detection ------------------------------------------------------------
# Detector confidence threshold (0..1).
# FR_DETECT_THRESHOLD=0.5

# --- Video ----------------------------------------------------------------
# Recognize every Nth frame in /recognize/video (default ~5 = ~2fps).
# FR_VIDEO_SAMPLE_EVERY=5

# --- CORS -------------------------------------------------------------
# Comma-separated list of allowed origins.
# FR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- CUDA -------------------------------------------------------------
# Directory containing CUDA runtime DLLs (cublasLt64_12.dll, cudnn64_9.dll,
# ...) used by onnxruntime-gpu. Usually auto-detected from a PyTorch install;
# set explicitly if auto-detection fails.
# FR_CUDA_LIB_DIR=C:\path\to\cuda\bin

# --- Paths -------------------------------------------------------------
# FR_DATA_DIR=./data
# FR_GALLERY_INDEX=./gallery.index
# FR_GALLERY_META=./gallery_meta.json
# FR_MODELS_DIR=./models

# --- Agent layer (new) --------------------------------------------------
# Local SQLite store + FAISS text-memory index (local-first; schema mirrors
# the Supabase pgvector tables in database/schema.sql).
# FR_DB_PATH=./agent.db
# FR_MEMORY_INDEX=./agent_memory.index
# FR_MEMORY_META=./agent_memory_meta.json
# FR_EVENT_QUEUE_MAX=1000
# FR_MEMORY_TTL=3600
# FR_DUPLICATE_WINDOW_SEC=10

# Optional LLM for deterministic agent reasoning (offline fallback when unset).
# FR_LLM_BASE_URL=https://api.openai.com/v1
# FR_LLM_API_KEY=
# FR_LLM_MODEL=gpt-4o-mini

# Notifications (all optional; gracefully no-op when unset).
# FR_TELEGRAM_BOT_TOKEN=
# FR_TELEGRAM_CHAT_ID=
# FR_SLACK_WEBHOOK_URL=
# FR_DISCORD_WEBHOOK_URL=
# FR_SMTP_HOST=smtp.gmail.com
# FR_SMTP_PORT=587
# FR_SMTP_USER=
# FR_SMTP_PASS=
# FR_SMTP_TO=
# FR_EMAIL_FROM=

# LangGraph is optional: install backend/requirements-agent.txt to run the
# agent pipeline as a StateGraph; otherwise a sequential async fallback is used.
